# ---------------------------------------------------------------------------
# Otto configuration. Copy to .env and fill in:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Lunaroute (cloud) -----------------------------------------------------
LUNAROUTE_API_KEY=
LUNAROUTE_BASE_URL=https://gw.lunaroute.com/v1

# STT model (Lunaroute transcription endpoint)
OTTO_STT_MODEL=whisper-large-v3
# Default chat model; the UI can switch between any model listed by /v1/models
OTTO_LLM_MODEL=deepseek-4.1-flash

# --- Session capabilities ------------------------------------------------
# Split work across parallel subagents (exposed to the model as delegate_task).
# The UI has a toggle for this too; this is just the default.
OTTO_PARALLEL_AGENTS=false
# Route subagents / background jobs through the model's *-background variant
# when Lunaroute publishes one (e.g. deepseek-4.1-flash-background).
OTTO_BACKGROUND_MODEL=false

# --- Google Workspace MCP ------------------------------------------------
# Gmail/Calendar tools run on Google's MCP servers (required for AI agents from
# Feb 1 2027). mode: mcp | auto | rest ; fallback keeps the old REST tools alive
# when the MCP endpoint is unavailable.
OTTO_MCP_ENABLED=true
OTTO_MCP_MODE=mcp
# Set this to your project when it differs from the OAuth client's default
# (override the endpoints in config/app.yaml → mcp.servers if Google moves them)

# --- Local TTS (GPU) ---
# trim the dead air Qwen3-TTS puts around each segment (smoother sentence joins)
OTTO_TTS_TRIM_SILENCE=1----------------------------------------------------
OTTO_TTS_URL=http://127.0.0.1:8801
OTTO_TTS_ENABLED=true
OTTO_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# GPU index the TTS service is pinned to (CUDA_VISIBLE_DEVICES for tts/server.py)
OTTO_TTS_GPU=1
OTTO_TTS_DEVICE=cuda:0
OTTO_TTS_CHUNK_SIZE=8

# --- Server ----------------------------------------------------------------
OTTO_HOST=127.0.0.1
OTTO_PORT=8800
OTTO_LOG_LEVEL=info
# Public base URL used for links and the Google OAuth redirect URI.
# Must match the redirect URI registered in Google Cloud exactly.
OTTO_PUBLIC_URL=http://127.0.0.1:8800

# --- Accounts --------------------------------------------------------------
# SQLite file holding users, sessions and per-user connection tokens
# (default: data/otto.db). Delete it to reset all accounts.
OTTO_DB_PATH=

# --- Google (Gmail + Calendar) --------------------------------------------
# Web app users connect Google themselves in Settings → Connections, so the
# server only needs ONE OAuth client. Either point GOOGLE_CLIENT_SECRETS at the
# downloaded JSON (OAuth client ID → Web application) or set the id/secret here.
#   Authorized redirect URI: ${OTTO_PUBLIC_URL}/oauth/google/callback
# See docs/AUTH.md for the click-by-click version.
# Any of these work without editing this file: the path below, or a downloaded
# client_secret_*.json dropped in secrets/ or in the repo root.
GOOGLE_CLIENT_SECRETS=secrets/google_client.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy single-user token for scripts (scripts/google_auth.py); the web app
# never uses it for a signed-in account.
GOOGLE_TOKEN_PATH=secrets/google_token.json
OTTO_GCAL_CALENDAR_ID=primary

# --- Slack -----------------------------------------------------------------
# Users can paste their own bot token in Settings → Connections. This env value
# is a server-wide fallback used by scripts / the single-user CLI mode.
# Scopes: channels:history, channels:read, chat:write, search:read,
# groups:history, im:history, users:read, users:read.email
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
